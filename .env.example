# Application
APP_NAME=CodeLearn AI
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=codelearn_ai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Or Direct Database URL
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/codelearn_ai

# Free-Tier LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=your_gemini_api_key_here

# Demo Auto-Seeding (Optional: set to true to pre-index demo repos on launch)
SEED_DEMO_REPOS=false
